read_enrollment <- function(year) {
  f <- file.path(enrolldir, paste0("Enrollment", year, ".xlsx"))
  df <- readxl::read_excel(f, sheet = "USE")  
  if ("Total Part D Enrollees" %in% names(df)) {
    df <- rename(df, Total_Part_D_Enrollees = `Total Part D Enrollees`)
  }
  df |>
    select(state_name, Total_Part_D_Enrollees)
}

