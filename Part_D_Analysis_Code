cal_staterates <- map(years, \(y) {
  sum_state_data <- georate_abx[[as.character(y)]]%>%
    group_by(state_name)%>%
    summarize(
      total_claims_bystate = sum(Tot_Clms, na.rm = TRUE),
      total_prescribers_bystate = sum(Tot_Prscrbrs, na.rm = TRUE),
      .groups = "drop"
    )
  #2 join the summarized data with total enrollee population by state
  final_state_data <- sum_state_data %>%
    left_join(staterate_data[[as.character(y)]], by = "state_name") %>%
    #: rate 
    mutate(abx_per1000enrollees = (total_claims_bystate / Total_Part_D_Enrollees) * 1000) %>%
    select(
      state_name,
      total_claims_bystate,
      total_prescribers_bystate,
      Total_Part_D_Enrollees,
      abx_per1000enrollees
    )
  return(final_state_data)
}) |> set_names(years)


