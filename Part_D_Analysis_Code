wb <- createWorkbook()
write_two_years <- function(wb, sheet_name, data_2022, data_2023) {
  addWorksheet(wb, sheet_name)
  # Write 2022
  writeData(wb, sheet = sheet_name,
            x = "Year: 2022",
            startRow = 1, startCol = 1)
  
  writeData(wb, sheet = sheet_name,
            x = data_2022,
            startRow = 2, startCol = 1)
  
  # determine where 2023 will start
  next_row <- nrow(data_2022) + 4
  
  writeData(wb, sheet = sheet_name,
            x = "Year: 2023",
            startRow = next_row - 1, startCol = 1)
  
  writeData(wb, sheet = sheet_name,
            x = data_2023,
            startRow = next_row, startCol = 1)
}
