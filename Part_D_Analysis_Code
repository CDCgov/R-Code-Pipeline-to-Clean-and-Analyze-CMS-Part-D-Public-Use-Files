read_provider <- function(year) {
  f <- file.path(providerdir, paste0("Medicare_Part_D_Prescribers_by_Provider_", year, ".csv"))
  readr::read_csv(f, show_col_types = FALSE) %>%
    select(Prscrbr_NPI, Prscrbr_Type, Prscrbr_State_Abrvtn, Prscrbr_State_FIPS, Prscrbr_RUCA, Antbtc_Tot_Clms) %>%
    filter(!Prscrbr_State_Abrvtn %in% c("XX","AA","AE","AP","AS","GU","MP","PR","PW","VI","ZZ")) %>%
    mutate(Antbtc_Tot_Clms = suppressWarnings(as.numeric(gsub(",","", Antbtc_Tot_Clms)))) |>
    filter(!is.na(Antbtc_Tot_Clms), Antbtc_Tot_Clms > 0)
}

