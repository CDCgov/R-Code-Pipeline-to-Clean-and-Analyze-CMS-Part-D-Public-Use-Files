#########################################################################
#* National summary --> grouped summary by state and provider type. 
#* This section will calculate the top 8 provider type within each state
#########################################################################

final_state_provider_list <- map(years, \(y){
  provider_state_summary <- geo_provider[[as.character(y)]]%>%
    group_by(state_name, Prscrbr_Type)%>%
    summarize(
      NumClaims = sum(Antbtc_Tot_Clms, na.rm = TRUE),
      NumPrescribers = sum(!is.na (Prscrbr_NPI)),
      year = y,
      .groups = "drop")
  
  #CALCULATE STATE TOTALS AND %
  
  provider_state_perc <- provider_state_summary%>%
    group_by(state_name)%>%
    mutate(
      StateTotalClaims = sum(NumClaims, na.rm = TRUE),
      PercentClaims = (NumClaims / StateTotalClaims) * 100,
      year = y) %>%
    arrange(state_name, desc(PercentClaims)) %>%
    ungroup()
  
  #CREATE TOP 8
  statetop8 <- provider_state_perc %>%
    group_by(state_name) %>%
    slice_head(n=8) %>%
    ungroup()
  
  #OTHER
  state_other <- provider_state_perc%>%
    group_by(state_name) %>%
    slice(-(1:8)) %>%
    summarize(
      Prscrbr_Type = "Other",
      NumPrescribers = sum(NumPrescribers, na.rm= TRUE),
      NumClaims = sum(NumClaims, na.rm = TRUE),
      PercentClaims = sum(PercentClaims, na.rm = TRUE),
      year= first(year),
      .groups = "drop")
  
  #CONCATENATE
  bind_rows(statetop8, state_other)%>%
    arrange(state_name, desc(PercentClaims))
}) |> set_names(years)

