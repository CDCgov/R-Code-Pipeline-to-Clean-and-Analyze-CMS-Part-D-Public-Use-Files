read_geodrug <- function(year) {
  f <- file.path(geodrugdir, paste0("Medicare_Part_D_Prescribers_by_Geography_and_Drug_", year, ".csv"))
  readr::read_csv(f,
                  col_types = cols(
                    Prscrbr_Geo_Cd = col_character(),
                    .default = col_guess()
                  ),
                  show_col_types = FALSE
  ) |>
    #Drop the territories and armed forces
    filter(!Prscrbr_Geo_Desc %in% c(
      "American Samoa", "Guam", "Northern Mariana Islands",
      "Puerto Rico", "Virgin Islands", "Foreign Country",
      "Unknown", "Armed Forces Europe", "Armed Forces Pacific",
      "Armed Forces Central/South America"
    )) |>
    select(
      Prscrbr_Geo_Lvl, Prscrbr_Geo_Cd, Prscrbr_Geo_Desc,Brnd_Name,
      Gnrc_Name, Tot_Prscrbrs, Tot_Clms, Tot_Benes, GE65_Tot_Clms, Antbtc_Drug_Flag
    ) |>
    filter(Antbtc_Drug_Flag == "Y")
}

