#SUMMARIZE ANTIBIOTIC CLAIMS BY PROVIDER TYPE (WHO IS DRIVING PRESCRIBING BEHAVIOR?)
national_list <- map(years, \(y) {
  geoproviderdf <- geo_provider[[as.character(y)]]
  provtype_num <- geoproviderdf %>%
    group_by(Prscrbr_Type) %>%
    summarize(
      NumClaims = sum(Antbtc_Tot_Clms, na.rm = TRUE),
      NumPrescribers = n_distinct(Prscrbr_NPI),
      .groups = "drop")
  #CALCULATE TOTAL NUMBER OF CLAIMS (sum(numclaims into :total claims)
  
  national_total_claims <- sum(provtype_num$NumClaims, na.rm = TRUE)
  
  #CALCULATE % OF CLAIMS BY PROVIDERS
  provider_percentage <- provtype_num %>%
    mutate(
      PercentClaims = (NumClaims / national_total_claims) * 100,
      year = y) %>%
    arrange(desc(PercentClaims)) 
  
  # CREATE TOP 8  AND OTHER CATAGORIZATION
  top8 <- provider_percentage %>% slice_head(n=8)
  other <-  provider_percentage %>% slice(9:n())
  
  #AGGREGATE OTHER CATAGORY
  other_aggregate <- other %>%
    summarize(
      Prscrbr_Type = "Other",
      NumPrescribers = sum(NumPrescribers, na.rm = TRUE),
      NumClaims = sum(NumClaims, na.rm= TRUE),
      PercentClaims = (NumClaims / national_total_claims) * 100
      year = y)
  #CONCATENATE TOP 8 WITH AGGREGATED OTHER
  final_year_data <- bind_rows(top8, other_aggregate)
  mutate(rateper1000 = (NumClaims / NumPrescribers) * 1000)
  return(final_year_data)
})

