#MERGE GEOCODES WITH PROVIDER_DIR BY STATE_ABBR (NEW FILE CALLED GEO_PROVIDER) TO GET STATE NAMES
geo_provider <- map(years, \(y) {
  prescriber_type <- prescriber[[as.character(y)]]
  prescriber_geo <- prescriber_type%>% 
    rename(state_abbr = Prscrbr_State_Abrvtn)%>%
    inner_join(geocodes, by = "state_abbr")
  return(prescriber_geo)
}) |>set_names(years)

